// Example Manthan OpenCode global config (copy of a working ~/.config/opencode/opencode.jsonc).
// Install:
//   mkdir -p ~/.config/opencode
//   cp examples/opencode.jsonc ~/.config/opencode/opencode.jsonc
// Then set MANTHAN_API_KEY in your shell (do not commit a real key).
// API host below is the shared GCP Manthan endpoint.
//
// No top-level / agent `model` pin — on Manthan launch the model picker opens
// (live GET /v1/models: READY workers only; static stubs offline are pruned);
// after you pick, warmup runs. Also available via `/models` / the model chip.
// Never pin sidecar ids (e.g. qwen3.5-4b) — they are hidden and fall back to Zen/Big Pickle.

{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "allow"
  },
  // Default thinking/effort chip = medium (no model pin — picker still opens on launch).
  "agent": {
    "build": {
      "variant": "medium",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "plan": {
      "variant": "medium",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "code": {
      "variant": "medium",
      "options": {
        "reasoningEffort": "medium"
      }
    }
  },
  "provider": {
    "manthan": {
      "name": "Manthan AI",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://34.47.151.185:3000/v1",
        "apiKey": "{env:MANTHAN_API_KEY}",
        "includeUsage": true,
        "timeout": 1200000,
        "chunkTimeout": 900000,
        "headers": {
          "Authorization": "Bearer {env:MANTHAN_API_KEY}",
          "x-api-key": "{env:MANTHAN_API_KEY}",
          "X-Manthan-Client": "opencode",
          "X-Manthan-Reasoning-Effort": "medium",
          "X-Title": "Manthan",
          "HTTP-Referer": "https://manthan.ai"
        }
      },
      "models": {
        "qwen3.5-122b-a10b": {
          "name": "Qwen3.5 122B A10B (G4 / SGLang NVFP4)",
          "reasoning": true,
